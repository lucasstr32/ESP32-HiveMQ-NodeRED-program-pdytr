Vagrant.configure("2") do |config|
  # 1. Imagen base (Box)
  config.vm.box = "ubuntu/focal64"
  config.vm.hostname = "servidor-iot"

  # 2. Configuración de Red y Puertos
  config.vm.network "forwarded_port", guest: 1880, host: 1880, auto_correct: true
  config.vm.network "forwarded_port", guest: 1883, host: 1883, auto_correct: true

  # 3. Recursos de Hardware (VirtualBox)
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "2048"
    vb.cpus = 1
    vb.name = "VM_IoT_NodeRED_Mosquitto"
    
    vb.customize ["modifyvm", :id, "--nested-hw-virt", "off"]
    vb.customize ["modifyvm", :id, "--hwvirtex", "on"]
    #vb.customize ["modifyvm", :id, "--vtxvpid", "on"]
    #vb.customize ["modifyvm", :id, "--pae", "on"]
    #vb.customize ["modifyvm", :id, "--paravirtprovider", "kvm"] # Utiliza la interfaz paravirtualizada nativa de Linux
    
    # Previene pánicos por desfasaje de reloj en el kernel
    # vb.customize ["modifyvm", :id, "--usehyperpacing", "on"]
  end

  # 4. Aprovisionamiento (Provisioning)
  config.vm.provision "shell", inline: <<-SHELL
    
    # Actualizar paquetes de Ubuntu
    echo "Actualizando paquetes de Ubuntu"
    apt-get update -y
    
    # Instalar dependencias
    apt-get install -y ca-certificates curl gnupg lsb-release
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    echo \
      "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
      $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null

    apt-get update -y
    apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
    
    # Dar permisos a Docker
    usermod -aG docker vagrant
    
    # Ejecutar Compose
    cd /vagrant
    docker compose up -d

    echo "Ejecutando Entorno IoT"
    
    
    
  SHELL
end
