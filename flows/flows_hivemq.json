    {
        "id": "ba5e83dac4bf3a6e",
        "type": "function",
        "z": "baf8fbf07fc84ccc",
        "name": "rtt_function",
        "func": "if (!msg.payload || msg.payload.corrected_tr === undefined) return null;\n\nvar t_emision_corregido = Number(msg.payload.corrected_tr);\nvar t_captura           = Date.now();\n\n// Latencia real: ya con offset de calibración aplicado\nvar latencia = t_captura - t_emision_corregido;\n\nmsg.payload = {\n    t_emision_original:  Number(msg.payload.tr),\n    t_emision_corregido: t_emision_corregido,\n    t_captura:           t_captura,\n    offset_calibration:     Number(msg.payload.offset),\n    latencia_ms:         latencia\n};\n\nconst N_MENSAJES = 200;\nvar historial_latencias = context.get('historial_latencias') || [];\nvar latencia_minima = context.get('latencia_minima');\nvar latencia_maxima = context.get('latencia_maxima');\n\n\nif (historial_latencias.length === 0) {\n    latencia_minima = latencia;\n    latencia_maxima = latencia;\n} else {\n    if (latencia < latencia_minima) latencia_minima = latencia;\n    if (latencia > latencia_maxima) latencia_maxima = latencia;\n}\nhistorial_latencias.push(latencia);\ncontext.set('historial_latencias', historial_latencias);\n\ncontext.set('latencia_minima', latencia_minima);\ncontext.set('latencia_maxima', latencia_maxima);\n\nif (historial_latencias.length === N_MENSAJES) {\n    historial_latencias.sort(function (a, b) { return a - b; });\n\n    var mediana_latencia = 0;\n    var mitad = Math.floor(N_MENSAJES / 2);\n\n    // Si N es impar, la mediana es el elemento central.\n    // Si N es par (como 20), la mediana es el promedio de los dos elementos centrales.\n    if (N_MENSAJES % 2 !== 0) {\n        mediana_latencia = historial_latencias[mitad];\n    } else {\n        mediana_latencia = (historial_latencias[mitad - 1] + historial_latencias[mitad]) / 2;\n    }\n\n\n    node.warn(\"Mediana Latencia: \" + mediana_latencia + \"ms\"\n    +\" || Piso: \" + latencia_minima + \"ms\"\n    +\" || Techo\" + latencia_maxima + \"ms\");\n\n    context.set('historial_latencias', []);\n    context.set('latencia_minima', null);\n    context.set('latencia_maxima', null);\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
