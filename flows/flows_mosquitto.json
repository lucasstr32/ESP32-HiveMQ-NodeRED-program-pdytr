    {
        "id": "543a4b3c423f6212",
        "type": "function",
        "z": "1665b9e3ca9a5ffd",
        "name": "rtt_function",
        "func": "if (!msg.payload || msg.payload.corrected_tr === undefined) return null;\n\nvar t_emision_corregido = Number(msg.payload.corrected_tr);\nvar t_captura           = Date.now();\nvar latencia            = t_captura - t_emision_corregido;\n\nvar t_emision_original  = Number(msg.payload.tr);\nvar offset_calibration  = Number(msg.payload.offset);\n\n// =================================================================\n// 1. FORMATO PARA SALIDA 1 (CSV: Lecturas en tiempo real)\n// =================================================================\n// Construimos la línea CSV directamente como String\nvar csvLine = `${t_captura},${t_emision_original},${t_emision_corregido},${offset_calibration},${latencia}`;\n\nvar msgCSV = {\n    payload: csvLine\n};\n\n// =================================================================\n// 2. LÓGICA DE HISTORIAL Y CÁLCULO DE MEDIANA\n// =================================================================\nconst N_MENSAJES = 200;\nvar historial_latencias = context.get('historial_latencias') || [];\nvar latencia_minima = context.get('latencia_minima');\nvar latencia_maxima = context.get('latencia_maxima');\n\nif (historial_latencias.length === 0) {\n    latencia_minima = latencia;\n    latencia_maxima = latencia;\n} else {\n    if (latencia < latencia_minima) latencia_minima = latencia;\n    if (latencia > latencia_maxima) latencia_maxima = latencia;\n}\n\nhistorial_latencias.push(latencia);\ncontext.set('historial_latencias', historial_latencias);\ncontext.set('latencia_minima', latencia_minima);\ncontext.set('latencia_maxima', latencia_maxima);\n\nvar msgMediana = null; // Por defecto no emitimos nada en la salida 2\n\nif (historial_latencias.length === N_MENSAJES) {\n    historial_latencias.sort(function (a, b) { return a - b; });\n\n    var mediana_latencia = 0;\n    var mitad = Math.floor(N_MENSAJES / 2);\n\n    if (N_MENSAJES % 2 !== 0) {\n        mediana_latencia = historial_latencias[mitad];\n    } else {\n        mediana_latencia = (historial_latencias[mitad - 1] + historial_latencias[mitad]) / 2;\n    }\n\n    node.warn(\"Mediana Latencia: \" + mediana_latencia + \"ms\"\n    +\" || Piso: \" + latencia_minima + \"ms\"\n    +\" || Techo: \" + latencia_maxima + \"ms\");\n\n    // Formateamos el objeto JSON para la Salida 2\n    msgMediana = {\n        payload: {\n            timestamp_calculo: Date.now(),\n            muestras_analizadas: N_MENSAJES,\n            mediana_latencia_ms: mediana_latencia,\n            latencia_minima_ms: latencia_minima,\n            latencia_maxima_ms: latencia_maxima,\n            offset_aplicado_ms: offset_calibration\n        }\n    };\n\n    // Reiniciar contadores del contexto\n    context.set('historial_latencias', []);\n    context.set('latencia_minima', null);\n    context.set('latencia_maxima', null);\n\n\n    // =================================================================\n    // 3. RETORNO MULTI-SALIDA (Salida 1: CSV, Salida 2: JSON)\n    // =================================================================\n    // Salida 1 enviará siempre un mensaje; Salida 2 solo enviará un mensaje cada 200 iteraciones\n    return [msgCSV, msgMediana];\n}\n\n",
        "outputs": 2,
