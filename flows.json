    {
        "id": "e522dc68b404f8bc",
        "type": "function",
        "z": "baf8fbf07fc84ccc",
        "name": "latency_function",
        "func": "if (!msg.payload || msg.payload.corrected_ts === undefined) return null;\n\nvar t_emision_corregido = Number(msg.payload.corrected_ts);\nvar t_captura           = Date.now();\nvar latencia            = t_captura - t_emision_corregido;\n\nvar t_emision_original = Number(msg.payload.emission_ts);\nvar offset_calibration  = Number(msg.payload.offset);\n\nvar csvLine = `${t_captura},${t_emision_original},${t_emision_corregido},${offset_calibration},${latencia}`;\n\nvar msgCSV = {\n    payload: csvLine\n};\n\nreturn msgCSV;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
